    {
      "parameters": {
        "jsCode": "// Light validation only - WF-10 handles full enforcement\nconst contract = $input.first().json;\n\n// Basic validation - ensure critical fields exist\nconst requiredFields = ['request_id', 'source_workflow', 'department', 'mode', 'confidence', 'risk_level', 'decision_status'];\nconst missing = requiredFields.filter(f => contract[f] === undefined || contract[f] === null);\n\nif (missing.length > 0) {\n  throw new Error(`Contract validation failed: Missing fields: ${missing.join(', ')}`);\n}\n\n// Check for malformed input\nif (typeof contract !== 'object' || Array.isArray(contract)) {\n  throw new Error('Contract validation failed: Invalid contract structure');\n}\n\nconsole.log('\u2705 Light validation passed for request:', contract.request_id);\n\nreturn [contract];"
